# Application Setup
NODE_ENV=production
PORT=5000
COOKIE_SECURE=false
APP_ORIGIN=http://localhost

# Database & Auth
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vortsuu.mongodb.net/?appName=Cluster0
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_RESET_SECRET=your_jwt_reset_secret_here

# External APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
GOOGLE_GENAI_API_KEY=your_google_genai_api_key

# Vector Search
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=careersync-v1

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=careersync-resumes
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com

# Transactional Email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Internal Operations
CLEANUP_SHARED_SECRET=your_cleanup_shared_secret

# Nodemailer googleOAuth
SMTP_USER=your_smtp_user_email
SMTP_PASS=your_smtp_password
