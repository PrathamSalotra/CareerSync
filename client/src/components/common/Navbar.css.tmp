.cs-nav-center {
  display: flex;
  align-items: center;
  gap: 1rem;
  background-color: var(--color-surface-container-low);
  padding: 0.25rem;
  border-radius: 2rem;
  border: 1px solid var(--color-outline-variant);
}

.cs-nav-center-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  font-family: var(--font-family);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-outline);
  text-decoration: none;
  transition: all var(--transition-fast);
}

.cs-nav-center-link:hover {
  color: var(--color-on-surface);
}

.cs-nav-center-link.active {
  background-color: var(--color-surface-container-lowest);
  color: var(--color-on-surface);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.cs-nav-center-link .material-symbols-outlined {
  font-size: 1.125rem;
}
